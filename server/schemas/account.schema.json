{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "erp/schemas/account.schema.json",
  "title": "حساب شجرة الحسابات (accounts)",
  "description": "عقدة في الشجرة الهرمية: مجموعة (لا تُرحَّل) أو حساب ترحيل ورقي. الحسابات الفرعية التحليلية للعملاء/الموظفين/الموردين/الخزائن بنت مبني على نفس العقد برمز مثل 1120-C0001.",
  "type": "object",
  "required": ["id", "code", "name", "type", "kind", "active"],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string", "description": "معرف الوثيقة = الرمز نفسه", "examples": ["1120", "1120-C0001"] },
    "code": { "type": "string", "pattern": "^\\d{4}(-[A-Z]\\d{2,6})?$" },
    "name": { "type": "string", "minLength": 2 },
    "type": { "enum": ["asset", "liability", "equity", "revenue", "expense"] },
    "kind": { "enum": ["group", "posting"], "description": "group = تجميعي ممنوع الترحيل، posting = ورقي يقبل القيود" },
    "parent": { "type": ["string", "null"], "description": "رمز الحساب الأب" },
    "active": { "type": "boolean" },
    "isSystem": { "type": "boolean", "description": "true لحسابات الشجرة الافتراضية المزروعة" },
    "controlFor": { "type": "string", "description": "إن كان حساباً رقابياً: customers|employees|suppliers|treasury" },
    "subOf": { "type": "string", "description": "للحساب الفرعي التحليلي: رمز الحساب الرقابي" },
    "meta": { "type": "object", "description": "ربط اختياري بكيان خارجي (customerId...)" },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
