{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "erp/schemas/payroll_run.schema.json",
  "title": "مسير رواتب (payroll_runs)",
  "description": "دورة كاملة: draft (احتساب) → approved (قيد استحقاق آلي: مدين 5100 بالإجمالي | دائن 2120-Exxxx بالصافي + 2130 تأمينات + 2140 ضرائب + 1140-Exxxx استقطاع سلف) → paid (قيد صرف من الخزينة). مسير واحد فقط لكل فترة.",
  "type": "object",
  "required": ["id", "number", "period", "date", "lines", "totals", "status", "createdBy"],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string" },
    "number": { "type": "string", "pattern": "^PR-\\d{4}-\\d{2}$", "description": "PR-الفترة — مسير واحد لكل شهر" },
    "period": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
    "date": { "type": "string", "format": "date", "description": "تاريخ ترحيل الاستحقاق (افتراضياً آخر يوم في الفترة)" },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["employeeId", "basic", "gross", "net"],
        "properties": {
          "employeeId": { "type": "string" },
          "employeeCode": { "type": "string" },
          "employeeName": { "type": "string" },
          "payableAccountCode": { "type": "string" },
          "advanceAccountCode": { "type": "string" },
          "basic": { "type": "integer", "minimum": 0 },
          "allowances": { "type": "integer", "minimum": 0 },
          "gross": { "type": "integer", "minimum": 0, "description": "basic + allowances" },
          "advancesDeducted": { "type": "integer", "minimum": 0, "description": "استقطاع سلف — لا يتجاوز السلف القائمة" },
          "insurance": { "type": "integer", "minimum": 0 },
          "tax": { "type": "integer", "minimum": 0 },
          "otherDeduction": { "type": "integer", "minimum": 0 },
          "net": { "type": "integer", "minimum": 0, "description": "gross − advancesDeducted − insurance − tax − otherDeduction" }
        }
      }
    },
    "totals": {
      "type": "object",
      "required": ["gross", "advances", "insurance", "tax", "otherDeductions", "net"],
      "properties": {
        "gross": { "type": "integer", "minimum": 0 },
        "advances": { "type": "integer", "minimum": 0 },
        "insurance": { "type": "integer", "minimum": 0 },
        "tax": { "type": "integer", "minimum": 0 },
        "otherDeductions": { "type": "integer", "minimum": 0 },
        "net": { "type": "integer", "minimum": 0 }
      }
    },
    "check": { "type": "boolean", "description": "gross − كل الاستقطاعات = net (إثبات داخلي إلزامي)" },
    "status": { "enum": ["draft", "approved", "paid"] },
    "journalEntryId": { "type": ["string", "null"], "description": "قيد الاستحقاق بعد الاعتماد" },
    "journalNumber": { "type": ["string", "null"] },
    "paymentEntryId": { "type": ["string", "null"], "description": "قيد الصرف بعد الدفع" },
    "paidFromTreasuryId": { "type": ["string", "null"] },
    "notes": { "type": "string" },
    "createdBy": { "type": "object" },
    "approvedBy": { "type": ["object", "null"] },
    "paidBy": { "type": ["object", "null"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
