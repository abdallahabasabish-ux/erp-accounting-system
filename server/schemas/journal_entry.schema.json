{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "erp/schemas/journal_entry.schema.json",
  "title": "قيد يومية (journal_entries)",
  "description": "السجل المحاسبي المركزي غير القابل للتعديل أو الحذف. كل معاملة مالية تولّد قيداً متوازناً: مجموع debit يساوي مجموع credit بالقروش تماماً. التصحيح الوحيد: قيد عكسي (type=reversal) مرتبط بالأصل عبر reversesOf.",
  "type": "object",
  "required": ["id", "number", "date", "periodKey", "type", "memo", "lines", "totalDebit", "totalCredit", "currency", "createdBy", "createdAt"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "description": "= الرقم التسلسلي (JE-2026-000123) — تفرد طبيعي" },
    "number": { "type": "string", "pattern": "^JE-\\d{4}-\\d{6}$" },
    "date": { "type": "string", "format": "date", "description": "تاريخ الترحيل المحاسبي YYYY-MM-DD" },
    "periodKey": { "type": "string", "pattern": "^\\d{4}-\\d{2}$", "description": "الفترة المالية الشهرية" },
    "type": { "enum": ["standard", "reversal", "closing", "opening", "adjusting"] },
    "memo": { "type": "string", "minLength": 3, "description": "وصف القيد" },
    "sourceRef": {
      "type": ["object", "null"],
      "properties": {
        "module": { "type": "string", "examples": ["invoices", "receipts", "payroll_runs", "expenses", "vouchers"] },
        "docId": { "type": ["string", "null"] },
        "number": { "type": ["string", "null"] }
      }
    },
    "lines": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["accountCode", "debit", "credit"],
        "properties": {
          "accountCode": { "type": "string", "description": "حساب ترحيلي ورقي نشط" },
          "accountName": { "type": "string", "description": "منسوخ وقت الترحيل (ثبات العرض)" },
          "debit": { "type": "integer", "minimum": 0, "description": "بالقروش" },
          "credit": { "type": "integer", "minimum": 0, "description": "بالقروش" },
          "note": { "type": "string" },
          "party": {
            "type": ["object", "null"],
            "description": "ربط الطرف التحليلي",
            "properties": {
              "kind": { "enum": ["customer", "employee", "supplier"] },
              "id": { "type": "string" },
              "name": { "type": "string" }
            }
          }
        },
        "allOf": [
          { "not": { "properties": { "debit": { "exclusiveMinimum": 0 }, "credit": { "exclusiveMinimum": 0 } }, "required": ["debit", "credit"] } }
        ]
      }
    },
    "totalDebit": { "type": "integer", "minimum": 1, "description": "∑ debit بالقروش" },
    "totalCredit": { "type": "integer", "minimum": 1, "description": "∑ credit — يجب أن يساوي totalDebit" },
    "currency": { "const": "EGP" },
    "createdBy": {
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "reversesOf": { "type": ["string", "null"], "description": "معرف القيد الأصلي إذا كان هذا القيد عكسياً" },
    "reversalReason": { "type": ["string", "null"], "description": "سبب العكس (إلزامي للقيد العكسي)" }
  },
  "description_note": "ضمان التوازن مُطبَّق في المحرك قبل التخزين؛ لا يوجد أي مسار تعديل أو حذف بعد الترحيل."
}
