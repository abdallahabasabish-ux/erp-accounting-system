{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "erp/schemas/receipt.schema.json",
  "title": "سند قبض (receipts)",
  "description": "تحصيل من عميل: قيد (مدين خزينة/بنك | دائن ذمة العميل) + تخصيص على فواتير محددة (صريح أو تلقائي FIFO بالأقرب استحقاقاً) — والفائض يبقى onAccount على الحساب. لا يُحذف؛ يُعكس بقيد عكسي.",
  "type": "object",
  "required": ["id", "number", "date", "customerId", "customerAccountCode", "treasuryAccountId", "amount", "allocations", "status", "journalEntryId"],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string", "description": "= الرقم" },
    "number": { "type": "string", "pattern": "^REC-\\d{4}-\\d{6}$" },
    "date": { "type": "string", "format": "date" },
    "customerId": { "type": "string" },
    "customerCode": { "type": "string" },
    "customerName": { "type": "string" },
    "customerAccountCode": { "type": "string" },
    "treasuryAccountId": { "type": "string" },
    "treasuryAccountName": { "type": "string" },
    "treasuryAccountCode": { "type": "string" },
    "amount": { "type": "integer", "minimum": 1, "description": "بالقروش" },
    "method": { "type": "string", "examples": ["نقدي", "تحويل بنكي", "محفظة إلكترونية"] },
    "allocations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["invoiceId", "amount"],
        "properties": {
          "invoiceId": { "type": "string" },
          "invoiceNumber": { "type": "string" },
          "amount": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "onAccount": { "type": "integer", "minimum": 0, "description": "الفائض غير المخصص على فواتير" },
    "status": { "enum": ["posted"] },
    "journalEntryId": { "type": "string" },
    "journalNumber": { "type": "string" },
    "notes": { "type": "string" },
    "createdBy": { "type": "object" },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
