{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "erp/schemas/user.schema.json",
  "title": "مستخدم النظام (users)",
  "description": "الهوية والأدوار والصلاحيات الدقيقة. disabled=true يُفحص في كل طلب — التعطيل فوري. في الإنتاج تُدار كلمة المرور عبر Firebase Auth، وهذه الوثيقة تحمل الدور والصلاحيات فقط.",
  "type": "object",
  "required": ["id", "email", "displayName", "role", "disabled", "createdAt"],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string", "description": "= Firebase Auth uid" },
    "email": { "type": "string", "format": "email" },
    "displayName": { "type": "string" },
    "role": { "enum": ["admin", "manager", "accountant", "employee", "client"] },
    "permissions": {
      "type": ["array", "null"],
      "items": { "type": "string" },
      "description": "صلاحيات مخصصة تتجاوز الافتراضي؛ '*' = الكل؛ null = افتراضي الدور"
    },
    "disabled": { "type": "boolean" },
    "disabledReason": { "type": ["string", "null"] },
    "employeeId": { "type": ["string", "null"], "description": "ربط بملف موظف (لمسار hr/me)" },
    "customerId": { "type": ["string", "null"], "description": "ربط بملف عميل (لبوابة العميل)" },
    "passwordHash": { "type": ["string", "null"], "description": "وضع التجربة فقط — لا يُخزَّن في الإنتاج" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
