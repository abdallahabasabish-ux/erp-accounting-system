{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "erp/schemas/invoice.schema.json",
  "title": "فاتورة (invoices)",
  "description": "فاتورة آجل تولّد قيداً تلقائياً: مدين ذمة العميل (1120-Cxxxx) بالإجمالي شاملاً الضريبة | دائن الإيراد (4100/4200/4300) بالصافي | دائن ضريبة مخرجات (2150). الإلغاء بقيد عكسي فقط — لا حذف. حالة الدفع تُحدَّث آلياً بسندات القبض المخصصة.",
  "type": "object",
  "required": ["id", "number", "date", "dueDate", "customerId", "customerAccountCode", "items", "subtotal", "vatRate", "vatAmount", "total", "paidTotal", "balance", "status", "journalEntryId", "createdBy"],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string", "description": "= رقم الفاتورة" },
    "number": { "type": "string", "pattern": "^INV-\\d{4}-\\d{6}$", "description": "تسلسل ذري من الخادم — بلا فجوات أو تكرار" },
    "date": { "type": "string", "format": "date" },
    "dueDate": { "type": "string", "format": "date", "description": "تاريخ الاستحقاق = التاريخ + creditDays للعميل" },
    "kind": { "enum": ["service", "product", "other"], "default": "service" },
    "customerId": { "type": "string" },
    "customerCode": { "type": "string", "examples": ["C0001"] },
    "customerName": { "type": "string" },
    "customerAccountCode": { "type": "string", "examples": ["1120-C0001"] },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["description", "qty", "unitPricePiasters", "totalPiasters"],
        "properties": {
          "description": { "type": "string" },
          "qty": { "type": "integer", "minimum": 1 },
          "unitPricePiasters": { "type": "integer", "minimum": 1 },
          "totalPiasters": { "type": "integer", "minimum": 1, "description": "qty × unitPrice" }
        }
      }
    },
    "subtotal": { "type": "integer", "minimum": 0, "description": "∑ البنود بالقروش" },
    "discount": { "type": "integer", "minimum": 0, "description": "خصم على مستوى الفاتورة بالقروش" },
    "vatRate": { "type": "number", "minimum": 0, "maximum": 100, "description": "نسبة VAT (افتراضي 14)" },
    "vatAmount": { "type": "integer", "minimum": 0, "description": "قيمة الضريبة بالقروش — تقريب نصف-لأعلى بحساب صحيح" },
    "total": { "type": "integer", "minimum": 1, "description": "subtotal − discount + vatAmount" },
    "paidTotal": { "type": "integer", "minimum": 0, "description": "يُحدَّث آلياً بسندات القبض المخصصة" },
    "balance": { "type": "integer", "description": "total − paidTotal" },
    "status": { "enum": ["unpaid", "partial", "paid", "cancelled"] },
    "journalEntryId": { "type": "string", "description": "القيد المولّد تلقائياً" },
    "journalNumber": { "type": "string" },
    "notes": { "type": "string" },
    "creditOverride": {
      "type": ["object", "null"],
      "description": "تجاوز الحد الائتماني (مدير + سبب موثق)",
      "properties": { "reason": { "type": "string" }, "by": { "type": "string" } }
    },
    "createdBy": { "type": "object", "properties": { "uid": { "type": "string" }, "email": { "type": "string" }, "name": { "type": "string" } } },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "cancelledAt": { "type": ["string", "null"], "format": "date-time" },
    "cancellationReason": { "type": ["string", "null"] },
    "reversalEntryId": { "type": ["string", "null"] }
  }
}
