{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "erp/schemas/customer.schema.json",
  "title": "عميل (customers)",
  "description": "العميل له حساب فرعي تحليلي في شجرة الحسابات (1120-Cxxxx). الحقل arBalancePiasters ذاكرة قراءة سريعة فقط — مصدر الحقيقة دائماً رصيد الحساب الفرعي في دفتر الأستاذ.",
  "type": "object",
  "required": ["id", "code", "name", "creditLimitPiasters", "creditDays", "active", "customerAccountCode", "createdAt"],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string" },
    "code": { "type": "string", "pattern": "^C\\d{4}$", "description": "رمز كياني متسلسل من الخادم" },
    "name": { "type": "string", "minLength": 2 },
    "phone": { "type": "string" },
    "email": { "type": "string" },
    "company": { "type": "string" },
    "address": { "type": "string" },
    "creditLimitPiasters": { "type": "integer", "minimum": 0, "description": "0 = بلا حد ائتماني" },
    "creditDays": { "type": "integer", "minimum": 0, "description": "فترة السداد Net-N (افتراضي 30)" },
    "arBalancePiasters": { "type": "integer", "description": "ذاكرة سريعة للذمم — تُشتق من دفتر الأستاذ" },
    "active": { "type": "boolean" },
    "uid": { "type": ["string", "null"], "description": "ربط حساب بوابة العميل (Firebase Auth uid)" },
    "customerAccountCode": { "type": "string", "examples": ["1120-C0001"] },
    "createdBy": { "type": "object" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
