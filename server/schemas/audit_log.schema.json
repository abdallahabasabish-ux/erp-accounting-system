{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "erp/schemas/audit_log.schema.json",
  "title": "سجل تدقيق (audit_logs)",
  "description": "append-only من الخادم داخل نفس معاملة العملية المالية — فشل التسجيل يلغي العملية نفسها (عكس النظام القديم حيث كان التسجيل اختيارياً من العميل).",
  "type": "object",
  "required": ["at", "actor", "action", "entity", "summary"],
  "additionalProperties": true,
  "properties": {
    "at": { "type": "string", "format": "date-time" },
    "actor": {
      "type": "object",
      "properties": {
        "uid": { "type": ["string", "null"] },
        "email": { "type": ["string", "null"] },
        "name": { "type": ["string", "null"] },
        "role": { "type": ["string", "null"] }
      }
    },
    "action": { "type": "string", "examples": ["invoice.create", "receipt.create", "payment.approve", "payroll.approve", "period.close", "user.disable"] },
    "entity": { "type": "string" },
    "entityId": { "type": ["string", "null"] },
    "summary": { "type": "string", "description": "وصف عربي مختصر للحدث" },
    "before": { "type": ["object", "null"] },
    "after": { "type": ["object", "null"] },
    "reason": { "type": ["string", "null"] }
  }
}
