{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "erp/schemas/fiscal_period.schema.json",
  "title": "فترة مالية (fiscal_periods)",
  "description": "فترة شهرية تُنشأ تلقائياً مفتوحة عند أول قيد يقع فيها. الإغلاق بمدير وسبب موثق؛ الإقفال السنوي يحول فترات السنة إلى locked نهائياً.",
  "type": "object",
  "required": ["id", "key", "status", "start", "end"],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string", "description": "= المفتاح" },
    "key": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
    "status": { "enum": ["open", "closed", "locked"] },
    "start": { "type": "string", "format": "date" },
    "end": { "type": "string", "format": "date" },
    "closedAt": { "type": ["string", "null"], "format": "date-time" },
    "closedBy": { "type": ["object", "null"] },
    "closeReason": { "type": ["string", "null"] },
    "reopenedAt": { "type": ["string", "null"], "format": "date-time" },
    "reopenReason": { "type": ["string", "null"] },
    "lockedAt": { "type": ["string", "null"], "format": "date-time" }
  }
}
