{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "erp/schemas/employee.schema.json",
  "title": "موظف (employees)",
  "description": "لكل موظف حسابان فرعيان في الشجرة: 1140-Exxxx (سلفة — أصل) و2120-Exxxx (راتب مستحق — التزام). حقول الرصيد ذاكرات قراءة، والمصدر أرصدة الحسابات الفرعية.",
  "type": "object",
  "required": ["id", "code", "name", "status", "salaryBasicPiasters", "allowancesPiasters", "advanceAccountCode", "payableAccountCode", "createdAt"],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string" },
    "code": { "type": "string", "pattern": "^E\\d{4}$" },
    "name": { "type": "string", "minLength": 2 },
    "position": { "type": "string" },
    "phone": { "type": "string" },
    "email": { "type": "string" },
    "uid": { "type": ["string", "null"], "description": "ربط حساب الدخول" },
    "salaryBasicPiasters": { "type": "integer", "minimum": 0 },
    "allowancesPiasters": { "type": "integer", "minimum": 0 },
    "insuranceEmployeePiasters": { "type": "integer", "minimum": 0, "description": "حصة الموظف من التأمينات (تُستقطع)" },
    "payrollTaxPiasters": { "type": "integer", "minimum": 0, "description": "ضريبة كسب العمل التقديرية (تُستقطع)" },
    "commissionPercent": { "type": "number", "minimum": 0, "maximum": 100 },
    "status": { "enum": ["active", "inactive", "on_leave"] },
    "hireDate": { "type": "string", "format": "date" },
    "advanceAccountCode": { "type": "string", "examples": ["1140-E0001"] },
    "payableAccountCode": { "type": "string", "examples": ["2120-E0001"] },
    "advancesOutstandingPiasters": { "type": "integer", "description": "ذاكرة سريعة — السلف القائمة" },
    "salariesPayablePiasters": { "type": "integer", "description": "ذاكرة سريعة — المستحقات غير المصروفة" },
    "createdBy": { "type": "object" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
