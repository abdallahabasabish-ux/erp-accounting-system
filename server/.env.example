# ==============================================================
# إعدادات النظام المحاسبي — انسخ هذا الملف إلى .env وعدّل القيم
# ==============================================================

# منفذ الخادم
PORT=4000

# --------------------------------------------------------------
# وضع التشغيل:
#   production = الاتصال الحقيقي بـ Firestore (يتطلب بيانات الخدمة أدناه)
#   demo       = قاعدة بيانات في الذاكرة مع بيانات تجريبية (للتجربة والتطوير)
# إذا تُرك فارغاً: يعمل وضع demo تلقائياً عند غياب بيانات حساب الخدمة
# --------------------------------------------------------------
MODE=demo

# --------------------------------------------------------------
# بيانات حساب خدمة Firebase (Service Account) — لوضع production
# الخيار 1: مسار ملف JSON
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json
# الخيار 2 (للنشر على Render/Railway): محتوى JSON كاملاً أو Base64 في متغير واحد
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}
# FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50Ii4uLg
# --------------------------------------------------------------
FIREBASE_PROJECT_ID=your-project-id

# --------------------------------------------------------------
# الإعدادات المالية
# --------------------------------------------------------------
DEFAULT_VAT_RATE=14
DEFAULT_CREDIT_DAYS=30
DEFAULT_ADVANCE_CAP_PERCENT=50
TIMEZONE=Africa/Cairo

# كلمات مرور المستخدمين التجريبيين (وضع demo فقط)
DEMO_PASSWORD=demo1234

# مفتاح سري لتوقيع الرموز التجريبية (وضع demo فقط)
DEMO_SECRET=change-me-in-production
